  {
    "id": "index.user.create(email:1)",
    "label": "Create index on user (email:1)",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "index does not already exist on user",
        "source": {
          "kind": "listIndexes",
          "collection": "user"
        },
        "filter": {
          "kind": "field",
          "field": "key",
          "op": "$eq",
          "value": {
            "email": 1
          }
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "create index on user",
        "command": {
          "kind": "createIndex",
          "collection": "user",
          "keys": [
            {
              "direction": 1,
              "field": "email"
            }
          ],
          "unique": true,
          "name": "email_1"
        }
      }
    ],
    "postcheck": [
      {
        "description": "index exists on user",
        "source": {
          "kind": "listIndexes",
          "collection": "user"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "key",
              "op": "$eq",
              "value": {
                "email": 1
              }
            },
            {
              "kind": "field",
              "field": "unique",
              "op": "$eq",
              "value": true
            }
          ]
        },
        "expect": "exists"
      }
    ]
  },
